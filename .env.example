# Copia questo file in .env.local (locale, MAI committato) e compila i valori.
# Due destinazioni diverse:
#  - VITE_*  → lette dal client (Vite le inietta nel bundle, sono PUBBLICHE una volta buildate)
#  - le altre → supabase secrets set NOME=valore (usate dalle Edge Function in supabase/functions/)

# ── Supabase (client) ────────────────────────────────────────────────────────
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=

# ── RevenueCat (abbonamento Pro nativo iOS/Android, build Capacitor) ────────
VITE_REVENUECAT_IOS_KEY=
VITE_REVENUECAT_ANDROID_KEY=

# ── Push notifications (client) ──────────────────────────────────────────────
VITE_VAPID_PUBLIC_KEY=

# ── Supabase (Edge Function) ─────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=
SB_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SB_SECRET_KEY=

# ── AI (fallback Gemini -> Groq -> Claude, basta una chiave per funzionare) ─
GEMINI_API_KEY=
GROQ_API_KEY=
ANTHROPIC_API_KEY=

# ── Email/notifiche (Edge Function) ──────────────────────────────────────────
RESEND_API_KEY=
ADMIN_ALERT_EMAIL=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CONTACT_EMAIL=mailto:you@example.com

# ── Integrazione con NutriPlan-Pro (pannello dietista) ──────────────────────
NUTRIPLAN_API_URL=
WEBHOOK_TOKEN=
